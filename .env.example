# ------------------------------------------------------------------
# Copy to .env.local for development, and set the same keys in your
# Vercel project settings for production.
# Never commit .env.local — it is git-ignored.
# ------------------------------------------------------------------

# Public site URL, no trailing slash. Used for canonical tags, sitemap,
# robots.txt and Open Graph image URLs.
NEXT_PUBLIC_SITE_URL=https://loancalculatorpro.in

# ---- Database ----------------------------------------------------
# Local development: a SQLite file on disk.
DATABASE_URL=file:./data/loancalculatorpro.db
DATABASE_AUTH_TOKEN=

# Production on Vercel: serverless filesystems are read-only and ephemeral,
# so a local file loses every write. Point these at Turso (hosted libSQL —
# SQLite-compatible, so none of the query code changes):
#   npm i -g turso
#   turso auth signup
#   turso db create loancalculatorpro
#   turso db show loancalculatorpro --url
#   turso db tokens create loancalculatorpro
# DATABASE_URL=libsql://loancalculatorpro-<org>.turso.io
# DATABASE_AUTH_TOKEN=<the token printed above>

# ---- Admin authentication ----------------------------------------
# The single admin account. There is no sign-up route.
ADMIN_EMAIL=you@example.com

# Generate with:  npm run gen:hash -- 'your-strong-password'
ADMIN_PASSWORD_HASH=

# Dev-only shortcut — used ONLY when ADMIN_PASSWORD_HASH is empty.
# Never set this in production.
# ADMIN_PASSWORD=

# Session signing key, minimum 32 characters. Generate with: npm run gen:secret
AUTH_SECRET=

# Salt for the one-way IP hash used by rate limiting and visitor counts.
# Any long random string. Changing it resets visitor de-duplication.
IP_SALT=

# ---- Google AdSense ----------------------------------------------
# The loader script and publisher id are already wired in (ca-pub-5705970236200354).
# Create display units in your AdSense dashboard and paste their slot ids here.
# Leave blank to render no ad in that position.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# ---- Search engine verification ----------------------------------
# Paste the token (not the whole meta tag) from each console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
