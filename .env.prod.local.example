# Production database target for the seed scripts.
#
#   cp .env.prod.local.example .env.prod.local
#
# then paste your Turso values below and run, for example:
#
#   npm run db:scheme-rates:prod
#   npm run db:investment-guides:prod
#
# .env.prod.local is git-ignored. It exists so you never have to edit
# .env.local and remember to change it back — an earlier round of that is what
# caused a seed to land in the local file instead of production.
#
# Get the values with:
#   turso db show <your-db> --url
#   turso db tokens create <your-db>

DATABASE_URL=libsql://your-db-name-org.turso.io
DATABASE_AUTH_TOKEN=
